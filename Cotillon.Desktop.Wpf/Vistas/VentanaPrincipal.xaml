<Window x:Class="Cotillon.Desktop.Wpf.Vistas.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Icon="/Recursos/cotillon.png"
        Title="Cotillón - Sistema de gestión" Height="820" Width="1380"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Fondo}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navegación -->
        <Border Grid.Column="0" Background="{StaticResource Lateral}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Recursos/cotillon.png" Width="42" Height="42"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Effect="{StaticResource SombraFicha}"/>
                        <TextBlock x:Name="LblNegocio" Text="Cotillón" FontFamily="Segoe UI" FontSize="19"
                                   FontWeight="Bold" Foreground="White" Margin="11,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource PieLateral}" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="LblUsuario" FontFamily="Segoe UI" FontSize="13"
                                   FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LblRol" FontFamily="Segoe UI" FontSize="11.5"
                                   Foreground="{DynamicResource TituloMenu}" Margin="0,1,0,10"/>
                        <Button Content="Cerrar sesión" Style="{StaticResource BotonSecundario}"
                                FontSize="12" Padding="10,6" Click="AlCerrarSesion"/>
                    </StackPanel>
                </Border>

                <!-- Sin barra visible: en pantallas chicas igual se desplaza con la
                     rueda, pero no se come ancho ni ensucia el panel. -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,0,6">
                    <StackPanel x:Name="PanelNavegacion">
                        <TextBlock x:Name="LblOperacion" Text="OPERACIÓN" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TituloMenu}" Margin="20,8,0,6"/>
                        <RadioButton x:Name="NavInicio" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.ViewDashboard}"
                                     Background="{StaticResource FichaIndigo}"
                                     Content="Inicio" IsChecked="True" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavVentas" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.CartVariant}"
                                     Background="{StaticResource FichaRosa}"
                                     Content="Ventas" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavCaja" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.CashRegister}"
                                     Background="{StaticResource FichaVerde}"
                                     Content="Caja" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavHistorialVentas" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.ReceiptTextOutline}"
                                     Background="{StaticResource FichaIndigo}"
                                     Content="Historial de ventas" Checked="AlNavegar"/>

                        <TextBlock x:Name="LblInventario" Text="INVENTARIO" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TituloMenu}" Margin="20,16,0,6"/>
                        <RadioButton x:Name="NavProductos" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.PackageVariantClosed}"
                                     Background="{StaticResource FichaCeleste}"
                                     Content="Productos" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavCatalogo" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.ShapeOutline}"
                                     Background="{StaticResource FichaCeleste}"
                                     Content="Secciones y categorías" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavStock" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.SwapVerticalBold}"
                                     Background="{StaticResource FichaCeleste}"
                                     Content="Movimientos de stock" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavCompras" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.TruckDelivery}"
                                     Background="{StaticResource FichaAmbar}"
                                     Content="Compras" Checked="AlNavegar"/>

                        <TextBlock x:Name="LblGestion" Text="GESTIÓN" FontFamily="Segoe UI" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TituloMenu}" Margin="20,16,0,6"/>
                        <RadioButton x:Name="NavClientes" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.AccountGroup}"
                                     Background="{StaticResource FichaVerde}"
                                     Content="Clientes" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavProveedores" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.Storefront}"
                                     Background="{StaticResource FichaVerde}"
                                     Content="Proveedores" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavReportes" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.ChartBox}"
                                     Background="{StaticResource FichaVioleta}"
                                     Content="Reportes" Checked="AlNavegar"/>

                        <TextBlock x:Name="LblAdministracion" Text="ADMINISTRACIÓN" FontFamily="Segoe UI"
                                   FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TituloMenu}" Margin="20,16,0,6"/>
                        <RadioButton x:Name="NavUsuarios" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.AccountKey}"
                                     Background="{StaticResource FichaAmbar}"
                                     Content="Usuarios" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavAuditoria" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.ShieldCheck}"
                                     Background="{StaticResource FichaAmbar}"
                                     Content="Auditoría" Checked="AlNavegar"/>
                        <RadioButton x:Name="NavConfiguracion" Style="{StaticResource BotonNavegacion}"
                                     Tag="{x:Static iconos:PackIconMaterialKind.Cog}"
                                     Background="{StaticResource FichaAmbar}"
                                     Content="Configuración" Checked="AlNavegar"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Superficie}" Padding="26,16"
                    BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ChipCaja" CornerRadius="14" Padding="12,6" Background="#FEF3C7">
                            <TextBlock x:Name="LblEstadoCaja" Text="Caja cerrada" FontFamily="Segoe UI"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#92400E"/>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock x:Name="LblTitulo" Text="Inicio" Style="{StaticResource Titulo}" FontSize="21"/>
                        <TextBlock x:Name="LblDescripcion" Text="Resumen del negocio"
                                   Style="{StaticResource Subtitulo}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl x:Name="Contenido" Grid.Row="1" Margin="0"/>
        </Grid>
    </Grid>
</Window>
