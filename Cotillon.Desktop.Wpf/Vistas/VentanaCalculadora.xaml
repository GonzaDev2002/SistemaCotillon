<Window x:Class="Cotillon.Desktop.Wpf.Vistas.VentanaCalculadora"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Icon="/Recursos/cotillon.png"
        Title="Calculadora de precios" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Superficie}">

    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Grid Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border CornerRadius="10" Background="{StaticResource FichaVioleta}"
                        Effect="{StaticResource SombraFicha}"/>
                <Border CornerRadius="10" Background="{StaticResource BrilloFicha}"/>
                <iconos:PackIconMaterial Kind="Calculator" Width="17" Height="17" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Calculadora de precios" Style="{StaticResource TituloSeccion}" Margin="0"/>
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Escribí en cualquier campo y los otros se recalculan solos."/>
            </StackPanel>
        </StackPanel>

        <!-- Lo que paga el negocio -->
        <Border Background="{StaticResource Fondo}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="LO QUE ME CUESTA" Style="{StaticResource Etiqueta}"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Costo del bulto" Style="{StaticResource Subtitulo}"/>
                        <TextBox x:Name="TxtCostoBulto" Text="0" FontSize="15" Height="40"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="÷" FontSize="19" VerticalAlignment="Bottom"
                               Margin="10,0,10,9" Foreground="{StaticResource TextoSecundario}"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Unidades que trae" Style="{StaticResource Subtitulo}"/>
                        <TextBox x:Name="TxtUnidades" Text="1" FontSize="15" Height="40"/>
                    </StackPanel>
                </Grid>

                <DockPanel>
                    <TextBlock Text="Costo por unidad" FontFamily="Segoe UI" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblCostoUnitario" Text="$ 0,00" HorizontalAlignment="Right"
                               FontFamily="Segoe UI" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextoPrimario}"/>
                </DockPanel>
                <TextBlock Text="Dejá las unidades en 1 si el costo ya es por unidad."
                           Style="{StaticResource Subtitulo}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- La cuenta: margen y precio, cada uno despeja al otro -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="LE GANO (% SOBRE EL COSTO)" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtMargen" Text="50" FontSize="19" Height="48"
                         TextAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="PRECIO DE VENTA" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtPrecio" Text="0" FontSize="19" Height="48"
                         TextAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- Atajos de margen: lo que más se usa, sin tipear -->
        <UniformGrid x:Name="PanelMargenes" Rows="1" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="REDONDEAR A" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="CboRedondeo" SelectedValuePath="Tag" Height="40">
                    <ComboBoxItem Tag="0" Content="Sin redondear" IsSelected="True"/>
                    <ComboBoxItem Tag="10" Content="A los $10"/>
                    <ComboBoxItem Tag="50" Content="A los $50"/>
                    <ComboBoxItem Tag="100" Content="A los $100"/>
                    <ComboBoxItem Tag="500" Content="A los $500"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="PRECIO ANTERIOR (opcional)" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtPrecioAnterior" Text="0" FontSize="15" Height="40"/>
            </StackPanel>
        </Grid>

        <!-- El resultado -->
        <Border x:Name="PanelResultado" Background="#EEF2FF" CornerRadius="10" Padding="16"
                BorderBrush="{StaticResource Primario}" BorderThickness="1.5">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="SE VENDE A" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="{StaticResource Primario}"/>
                    <TextBlock x:Name="LblPrecioFinal" Text="$ 0,00" HorizontalAlignment="Right"
                               FontFamily="Segoe UI" FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource Primario}"/>
                </DockPanel>

                <TextBlock x:Name="LblGanancia" Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <TextBlock x:Name="LblComparacion" Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="LblAlerta" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Peligro}" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cerrar  (Esc)" Style="{StaticResource BotonSecundario}"
                    Height="44" Margin="0,0,5,0" Click="AlCerrar"/>
            <Button Grid.Column="1" x:Name="BtnUsar" Content="Usar estos valores  (Enter)"
                    Style="{StaticResource BotonExito}" Height="44" Margin="5,0,0,0" Click="AlUsar"/>
        </Grid>
    </StackPanel>
</Window>
