<Window x:Class="Cotillon.Desktop.Wpf.Vistas.VentanaAumentoPrecios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Icon="/Recursos/cotillon.png"
        Title="Ajustar precios" Height="680" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Superficie}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Grid Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border CornerRadius="10" Background="{StaticResource FichaAmbar}"
                        Effect="{StaticResource SombraFicha}"/>
                <Border CornerRadius="10" Background="{StaticResource BrilloFicha}"/>
                <iconos:PackIconMaterial Kind="TagMultiple" Width="17" Height="17" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ajustar precios" Style="{StaticResource TituloSeccion}" Margin="0"/>
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Mirá la lista antes de aplicar. Un porcentaje mal tipeado sobre una sección entera no se nota hasta que alguien compra."/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="SECCIÓN" Style="{StaticResource Etiqueta}"/>
                        <ComboBox x:Name="CboSeccion" DisplayMemberPath="NombreSeccion"
                                  SelectedValuePath="SeccionId" SelectionChanged="AlCambiarFiltro"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="CATEGORÍA" Style="{StaticResource Etiqueta}"/>
                        <ComboBox x:Name="CboCategoria" DisplayMemberPath="NombreCategoria"
                                  SelectedValuePath="CategoriaId" SelectionChanged="AlCambiarFiltroSimple"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="TEMPORADA" Style="{StaticResource Etiqueta}"/>
                        <ComboBox x:Name="CboTemporada" DisplayMemberPath="Nombre"
                                  SelectedValuePath="Codigo" SelectionChanged="AlCambiarFiltroSimple"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="MARCA" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtMarca" TextChanged="AlCambiarTexto"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="PORCENTAJE" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtPorcentaje" Text="0" Width="110" FontSize="19" Height="46"
                                 TextAlignment="Center" FontWeight="SemiBold" TextChanged="AlCambiarTexto"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="REDONDEAR A" Style="{StaticResource Etiqueta}"/>
                        <ComboBox x:Name="CboRedondeo" Width="150" Height="46" SelectedValuePath="Tag"
                                  SelectionChanged="AlCambiarFiltroSimple">
                            <ComboBoxItem Tag="0" Content="Sin redondear" IsSelected="True"/>
                            <ComboBoxItem Tag="10" Content="A los $10"/>
                            <ComboBoxItem Tag="50" Content="A los $50"/>
                            <ComboBoxItem Tag="100" Content="A los $100"/>
                            <ComboBoxItem Tag="500" Content="A los $500"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox x:Name="ChkAjustarCosto" IsChecked="True" Click="AlCambiarFiltro"
                                  Content="Subir también el costo"/>
                        <TextBlock Text="Cuando el aumento viene del proveedor, corresponde: si sólo sube el precio, el margen que informa el sistema miente."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="26,4,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid x:Name="Grilla" BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="160"/>
                    <DataGridTextColumn Header="Precio hoy" Binding="{Binding PrecioActual, StringFormat=C2}" Width="110"/>
                    <DataGridTextColumn Header="Queda en" Binding="{Binding PrecioNuevo, StringFormat=C2}" Width="110"/>
                    <DataGridTextColumn Header="Costo" Binding="{Binding CostoNuevo, StringFormat=C2}" Width="110"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <!-- Lo único que hay que mirar de verdad en 200 filas -->
                            <DataTrigger Binding="{Binding QuedaEnPerdida}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                                <Setter Property="ToolTip" Value="El precio queda por debajo del costo."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="LblEstado" Style="{StaticResource Subtitulo}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>

            <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Height="44" MinWidth="130" Margin="0,0,10,0" Click="AlCancelar"/>
            <Button Grid.Column="2" x:Name="BtnAplicar" Content="Aplicar" IsEnabled="False"
                    Style="{StaticResource BotonExito}" Height="44" MinWidth="190" Click="AlAplicar"/>
        </Grid>
    </Grid>
</Window>
