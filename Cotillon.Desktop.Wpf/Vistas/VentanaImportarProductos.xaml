<Window x:Class="Cotillon.Desktop.Wpf.Vistas.VentanaImportarProductos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Icon="/Recursos/cotillon.png"
        Title="Importar lista de productos" Height="680" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Superficie}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Grid Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border CornerRadius="10" Background="{StaticResource FichaIndigo}"
                        Effect="{StaticResource SombraFicha}"/>
                <Border CornerRadius="10" Background="{StaticResource BrilloFicha}"/>
                <iconos:PackIconMaterial Kind="TableArrowDown" Width="17" Height="17" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Importar lista de productos" Style="{StaticResource TituloSeccion}" Margin="0"/>
                <TextBlock Style="{StaticResource Subtitulo}"
                           Text="Copiá las filas desde Excel y pegalas acá con Ctrl+V. Entran todas juntas."/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="SECCIÓN" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboSeccion" DisplayMemberPath="NombreSeccion"
                              SelectedValuePath="SeccionId" SelectionChanged="AlCambiarSeccion"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="CATEGORÍA" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboCategoria" DisplayMemberPath="NombreCategoria"
                              SelectedValuePath="CategoriaId"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="CÓMO SE VENDEN" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboUnidad" MinWidth="150"
                              DisplayMemberPath="Nombre" SelectedValuePath="Codigo"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,7,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Etiqueta}"
                           Text="PEGÁ ACÁ LA LISTA"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Subtitulo}"
                           TextWrapping="Wrap" Margin="0,7,0,0"
                           Text="Columnas: Nombre · Precio · Costo · Stock · Código de barras. Sólo el nombre y el precio son obligatorios. Si la primera fila es el encabezado, se saltea sola."/>
                <TextBox x:Name="TxtLista" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="AlCambiarLista"/>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="7,0,0,0">
                <TextBlock DockPanel.Dock="Top" x:Name="LblResumen" Style="{StaticResource Etiqueta}"
                           Text="VISTA PREVIA"/>
                <Border Style="{StaticResource Tarjeta}" Padding="0">
                    <DataGrid x:Name="GrillaPrevia" BorderThickness="0" IsReadOnly="True"
                              AutoGenerateColumns="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Linea}" Width="36"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}"
                                                Width="Auto"/>
                            <DataGridTextColumn Header="Costo" Binding="{Binding Costo, StringFormat=C2}"
                                                Width="Auto"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat=0.###}"
                                                Width="Auto"/>
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <!-- Lo que no se va a importar se ve de entrada, con el
                                         motivo en el tooltip del renglón. -->
                                    <DataTrigger Binding="{Binding EsValida}" Value="False">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                        <Setter Property="ToolTip" Value="{Binding Error}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="LblErrores" Style="{StaticResource Subtitulo}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="LblEstado" Style="{StaticResource Subtitulo}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>

            <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Height="44" MinWidth="130" Margin="0,0,10,0" Click="AlCancelar"/>
            <Button Grid.Column="2" x:Name="BtnImportar" Content="Importar" IsEnabled="False"
                    Style="{StaticResource BotonExito}" Height="44" MinWidth="170" Click="AlImportar"/>
        </Grid>
    </Grid>
</Window>
