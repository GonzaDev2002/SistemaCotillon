<Window x:Class="Cotillon.Desktop.Wpf.Vistas.VentanaMotivo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Icon="/Recursos/cotillon.png"
        Title="Motivo" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Superficie}">

    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Grid Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border CornerRadius="10" Background="{StaticResource FichaAmbar}"
                        Effect="{StaticResource SombraFicha}"/>
                <Border CornerRadius="10" Background="{StaticResource BrilloFicha}"/>
                <iconos:PackIconMaterial Kind="CommentAlertOutline" Width="17" Height="17"
                                         Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="LblTitulo" Style="{StaticResource TituloSeccion}" Margin="0"/>
                <TextBlock x:Name="LblDetalle" Style="{StaticResource Subtitulo}" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- Los motivos de siempre, a un clic, para que escribir el motivo no
             sea el paso que invita a buscarle la vuelta. -->
        <UniformGrid x:Name="PanelSugerencias" Columns="2" Margin="0,0,0,10"/>

        <TextBlock Text="MOTIVO" Style="{StaticResource Etiqueta}"/>
        <TextBox x:Name="TxtMotivo" FontSize="15" MinHeight="44" KeyDown="AlTecla"/>

        <TextBlock x:Name="LblAviso" Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Volver  (Esc)" Style="{StaticResource BotonSecundario}"
                    Height="44" Margin="0,0,5,0" Click="AlVolver"/>
            <Button Grid.Column="1" x:Name="BtnAceptar" Content="Confirmar  (Enter)"
                    Style="{StaticResource BotonPeligro}" Height="44" Margin="5,0,0,0" Click="AlAceptar"/>
        </Grid>
    </StackPanel>
</Window>
