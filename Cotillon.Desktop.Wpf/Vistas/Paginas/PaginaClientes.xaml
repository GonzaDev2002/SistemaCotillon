<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaClientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="26,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,16,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{StaticResource Borde}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Buscar" Style="{StaticResource BotonPrimario}"
                                Margin="8,0,0,0" Click="AlBuscar"/>
                        <CheckBox DockPanel.Dock="Right" x:Name="ChkInactivos" Content="Ver inactivos"
                                  VerticalAlignment="Center" Margin="12,0" Click="AlBuscar"/>
                        <TextBox x:Name="TxtBuscar" KeyDown="AlTecla"
                                 ToolTip="Nombre, documento o teléfono"/>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="Grilla" BorderThickness="0" SelectionChanged="AlSeleccionar">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*"/>
                        <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="130"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="130"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="LblFormulario" Text="Nuevo cliente" Style="{StaticResource TituloSeccion}"/>

                    <TextBlock Text="NOMBRE COMPLETO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtNombre" Margin="0,0,0,10"/>

                    <TextBlock Text="DOCUMENTO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtDocumento" Margin="0,0,0,10"/>

                    <TextBlock Text="TELÉFONO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtTelefono" Margin="0,0,0,10"/>

                    <TextBlock Text="EMAIL" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtEmail" Margin="0,0,0,10"/>

                    <TextBlock Text="DIRECCIÓN" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtDireccion" Margin="0,0,0,10"/>

                    <TextBlock Text="OBSERVACIONES" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtObservaciones" Height="60" AcceptsReturn="True"
                             TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <CheckBox x:Name="ChkActivo" Content="Activo" IsChecked="True" Margin="0,0,0,14"/>

                    <Button x:Name="BtnGuardar" Content="Guardar" Style="{StaticResource BotonPrimario}"
                            Click="AlGuardar"/>
                    <Button Content="Nuevo (limpiar)" Style="{StaticResource BotonSecundario}"
                            Margin="0,8,0,0" Click="AlNuevo"/>
                    <Button x:Name="BtnBaja" Content="Dar de baja" Style="{StaticResource BotonPeligro}"
                            Margin="0,8,0,0" Click="AlDarDeBaja" IsEnabled="False"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
