<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaProductos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controles="clr-namespace:Cotillon.Desktop.Wpf.Controles">

    <Grid Margin="26,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="240"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,14">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{StaticResource Borde}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BotonSecundario}"
                                    Padding="12,7" Margin="8,0,0,0" Click="AlRefrescar" ToolTip="Actualizar">
                                <iconos:PackIconMaterial Kind="Refresh" Width="16" Height="16"/>
                            </Button>
                            <CheckBox DockPanel.Dock="Right" x:Name="ChkInactivos" Content="Ver dados de baja"
                                      VerticalAlignment="Center" Margin="12,0" Click="AlRefrescar"/>
                            <TextBox x:Name="TxtFiltro" TextChanged="AlFiltrar"
                                     ToolTip="Filtrar por nombre, sección o categoría"/>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="Grilla" BorderThickness="0" SelectionChanged="AlSeleccionar">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                            <DataGridTextColumn Header="Sección" Binding="{Binding NombreSeccion}" Width="130"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="130"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="110"/>
                            <!-- Con la unidad al lado: "2,5 kg" se lee distinto que "2,5" -->
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockFormateado}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Fotos y fichas del producto: ayudan a mostrarlo y a reconocerlo -->
            <Border Grid.Row="1" Style="{StaticResource Tarjeta}">
                <controles:PanelAdjuntos x:Name="Adjuntos" EntidadTipo="PRODUCTO"/>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="LblFormulario" Text="Nuevo producto"
                               Style="{StaticResource TituloSeccion}"/>

                    <!-- Lector de código de barras. Arranca enfocado: el lector es un
                         teclado que escribe el código y manda Enter, así que con
                         disparar sobre la etiqueta queda cargado todo el producto. -->
                    <Border CornerRadius="10" Padding="13" Margin="0,0,0,14" Background="#EEF2FF"
                            BorderBrush="{StaticResource Primario}" BorderThickness="1.5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Grid Width="26" Height="26">
                                    <Border CornerRadius="8" Background="{StaticResource FichaIndigo}"
                                            Effect="{StaticResource SombraFicha}"/>
                                    <Border CornerRadius="8" Background="{StaticResource BrilloFicha}"/>
                                    <iconos:PackIconMaterial Kind="BarcodeScan" Width="14" Height="14"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="CÓDIGO DE BARRAS" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource Primario}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                            </StackPanel>

                            <TextBox x:Name="TxtCodigoBarras" FontSize="16" MinHeight="42"
                                     KeyDown="AlTeclaCodigo"
                                     ToolTip="Dispará el lector sobre la etiqueta, o escribí el código y apretá Enter"/>

                            <TextBlock x:Name="LblEscaneo" Style="{StaticResource Subtitulo}"
                                       TextWrapping="Wrap" Margin="0,7,0,0"
                                       Text="Dispará el lector sobre la etiqueta. Si el código ya existe se cargan todos los campos para editarlo; si es nuevo, completás el resto."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SECCIÓN" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboSeccion" DisplayMemberPath="NombreSeccion" SelectedValuePath="SeccionId"
                              SelectionChanged="AlCambiarSeccion" Margin="0,0,0,10"/>

                    <TextBlock Text="CATEGORÍA" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboCategoria" DisplayMemberPath="NombreCategoria"
                              SelectedValuePath="CategoriaId" Margin="0,0,0,10"/>

                    <TextBlock Text="NOMBRE" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtNombre" Margin="0,0,0,10"/>

                    <TextBlock Text="CÓDIGO INTERNO (opcional)" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtCodigoProducto" Margin="0,0,0,10"
                             ToolTip="Para los artículos sin código de barras: el que le pone el negocio"/>

                    <!-- Define si al vender se agrega de a uno o se pregunta el peso -->
                    <TextBlock Text="CÓMO SE VENDE" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboUnidad" DisplayMemberPath="Nombre" SelectedValuePath="Codigo"
                              SelectionChanged="AlCambiarUnidad" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock x:Name="LblPrecio" Text="PRECIO POR UNIDAD"
                                       Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtPrecio" Text="0" TextChanged="AlCambiarPrecioOCosto"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock x:Name="LblCosto" Text="COSTO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtCosto" Text="0" TextChanged="AlCambiarPrecioOCosto"/>
                        </StackPanel>
                    </Grid>

                    <!-- Margen calculado al tipear: evita cargar un precio por debajo del costo -->
                    <Border x:Name="PanelMargen" CornerRadius="8" Padding="11,7" Margin="0,0,0,10"
                            Background="{StaticResource Fondo}" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock Text="Margen" Style="{StaticResource Subtitulo}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblMargen" HorizontalAlignment="Right" FontFamily="Segoe UI"
                                       FontSize="13.5" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock x:Name="LblStock" Text="STOCK" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtStock" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock x:Name="LblStockMinimo" Text="STOCK MÍNIMO"
                                       Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtStockMinimo" Text="0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="UNIDADES POR BULTO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtUnidadesPorBulto" Text="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="PRECIO DEL BULTO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtPrecioBulto" Text="0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="La bolsa de globos viene de 50: poné 50 y el precio de la bolsa. El stock se sigue llevando en unidades sueltas. Dejá 1 si no se vende por bulto."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock Text="TEMPORADA" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboTemporada" DisplayMemberPath="Nombre" SelectedValuePath="Codigo"
                              Margin="0,0,0,10"/>

                    <CheckBox x:Name="ChkEsCombo" Content="Es un combo (se arma con otros productos)"
                              Margin="0,0,0,6" Checked="AlCambiarCombo" Unchecked="AlCambiarCombo"/>

                    <!-- La receta del combo. Sólo aparece cuando el producto es uno:
                         en el 95 % de los productos sería ruido. -->
                    <Border x:Name="PanelCombo" Background="#EEF2FF" CornerRadius="10" Padding="12"
                            Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="QUÉ LLEVA ADENTRO" Style="{StaticResource Etiqueta}"/>
                            <DataGrid x:Name="GrillaCombo" MaxHeight="150" BorderThickness="0"
                                      Background="Transparent" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                                    <DataGridTextColumn Header="Lleva" Binding="{Binding CantidadFormateada}" Width="Auto"/>
                                    <DataGridTextColumn Header="Alcanza para" Binding="{Binding CombosQueAlcanza, StringFormat=0}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Quitar" Width="72"
                                        Style="{StaticResource BotonSecundario}" FontSize="12" Padding="8,6"
                                        Margin="6,0,0,0" Click="AlQuitarComponente"/>
                                <Button DockPanel.Dock="Right" Content="Agregar" Width="80"
                                        Style="{StaticResource BotonSecundario}" FontSize="12" Padding="8,6"
                                        Click="AlAgregarComponente"/>
                                <TextBox x:Name="TxtComponente" KeyDown="AlTeclaComponente"
                                         ToolTip="Escaneá o escribí el producto, y la cantidad separada con *"/>
                            </DockPanel>
                            <TextBlock Text="Escaneá el producto, o escribí «5*caramelo» para que lleve 5."
                                       Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="LblCostoCombo" Style="{StaticResource Subtitulo}"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MARCA" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtMarca" Margin="0,0,0,10"/>

                    <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtDescripcion" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                             Margin="0,0,0,10"/>

                    <CheckBox x:Name="ChkSinStock" Content="Permite vender sin stock" Margin="0,4,0,14"/>

                    <Button x:Name="BtnGuardar" Content="Guardar producto"
                            Style="{StaticResource BotonPrimario}" Click="AlGuardar"/>
                    <TextBlock Text="Enter pasa al campo siguiente · F12 guarda y vuelve al lector"
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,7,0,0"/>
                    <Button Content="Nuevo (limpiar)" Style="{StaticResource BotonSecundario}"
                            Margin="0,8,0,0" Click="AlNuevo"/>
                    <Button x:Name="BtnImportar" Content="Importar lista desde Excel"
                            Style="{StaticResource BotonSecundario}" Margin="0,8,0,0"
                            Click="AlImportar" Visibility="Collapsed"/>
                    <Button x:Name="BtnEliminar" Content="Dar de baja" Style="{StaticResource BotonPeligro}"
                            Margin="0,8,0,0" Click="AlEliminar" IsEnabled="False"/>
                    <!-- Aparece sólo con un producto dado de baja cargado: al escanear
                         una etiqueta vieja hay que poder volver a ponerlo en venta. -->
                    <Button x:Name="BtnReactivar" Content="Volver a poner en venta"
                            Style="{StaticResource BotonExito}" Margin="0,8,0,0"
                            Click="AlReactivar" Visibility="Collapsed"/>

                    <TextBlock x:Name="LblStockAviso" Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
