<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaHistorialVentas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="26,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,16,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{StaticResource Borde}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Desde" Style="{StaticResource Subtitulo}" VerticalAlignment="Center"/>
                        <DatePicker x:Name="FechaDesde" Width="130" Margin="8,0"/>
                        <TextBlock Text="Hasta" Style="{StaticResource Subtitulo}" VerticalAlignment="Center"/>
                        <DatePicker x:Name="FechaHasta" Width="130" Margin="8,0"/>
                        <CheckBox x:Name="ChkAnuladas" Content="Incluir anuladas" VerticalAlignment="Center"
                                  Margin="8,0"/>
                        <Button Content="Buscar" Style="{StaticResource BotonPrimario}" Margin="8,0,0,0"
                                Click="AlBuscar"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="18,12">
                    <DockPanel>
                        <TextBlock x:Name="LblCantidad" Text="0 ventas" Style="{StaticResource Subtitulo}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblTotal" Text="$ 0,00" HorizontalAlignment="Right"
                                   FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Primario}"/>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="Grilla" BorderThickness="0" SelectionChanged="AlSeleccionar">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding VentaId}" Width="60"/>
                        <DataGridTextColumn Header="Fecha" Width="140"
                                            Binding="{Binding FechaVenta, StringFormat=dd/MM/yyyy HH:mm}"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                        <DataGridTextColumn Header="Vendedor" Binding="{Binding Usuario}" Width="150"/>
                        <DataGridTextColumn Header="Items" Binding="{Binding CantidadItems}" Width="60"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalVenta, StringFormat=C2}" Width="110"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" x:Name="PanelAnular" Visibility="Collapsed">
                    <TextBlock Text="MOTIVO DE ANULACIÓN" Style="{StaticResource Etiqueta}" Margin="0,12,0,4"/>
                    <TextBox x:Name="TxtMotivo" Height="36"/>
                    <Button x:Name="BtnAnular" Content="Anular venta" Style="{StaticResource BotonPeligro}"
                            Margin="0,10,0,0" Click="AlAnular"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="LblDetalle" Text="Elegí una venta para ver el detalle"
                               Style="{StaticResource TituloSeccion}"/>

                    <DataGrid x:Name="GrillaDetalle" Height="230" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="55"/>
                            <DataGridTextColumn Header="Subtotal" Width="100"
                                                Binding="{Binding SubtotalLinea, StringFormat=C2}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Pagos" Style="{StaticResource Etiqueta}"/>
                    <ItemsControl x:Name="ListaPagos" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="{Binding MedioPago}" Style="{StaticResource Subtitulo}"/>
                                    <TextBlock Text="{Binding Importe, StringFormat=C2}" HorizontalAlignment="Right"
                                               FontFamily="Segoe UI" FontSize="13"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Subtotal" Style="{StaticResource Subtitulo}"/>
                                <TextBlock x:Name="LblSubtotal" Text="-" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="13"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Descuentos" Style="{StaticResource Subtitulo}"/>
                                <TextBlock x:Name="LblDescuento" Text="-" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="13"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Total" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblTotalVenta" Text="-" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource Primario}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
