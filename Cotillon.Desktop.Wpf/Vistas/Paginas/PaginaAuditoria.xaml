<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaAuditoria"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Tarjeta}" Margin="26,22" Padding="0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{StaticResource Borde}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Desde" Style="{StaticResource Subtitulo}" VerticalAlignment="Center"/>
                    <DatePicker x:Name="FechaDesde" Width="130" Margin="8,0"/>
                    <TextBlock Text="Hasta" Style="{StaticResource Subtitulo}" VerticalAlignment="Center"/>
                    <DatePicker x:Name="FechaHasta" Width="130" Margin="8,0"/>
                    <Button Content="Buscar" Style="{StaticResource BotonPrimario}"
                            Margin="8,0,0,0" Click="AlBuscar"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="18,12">
                <TextBlock x:Name="LblCantidad" Text="0 eventos" Style="{StaticResource Subtitulo}"/>
            </Border>

            <DataGrid x:Name="Grilla" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Width="145"
                                        Binding="{Binding FechaEvento, StringFormat=dd/MM/yyyy HH:mm:ss}"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="170"/>
                    <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="150"/>
                    <DataGridTextColumn Header="Tabla" Binding="{Binding TablaAfectada}" Width="140"/>
                    <DataGridTextColumn Header="Registro" Binding="{Binding RegistroId}" Width="80"/>
                    <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="*"/>
                    <DataGridTextColumn Header="Terminal" Binding="{Binding Terminal}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
