<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaVentas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="26,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Buscador y carrito -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="16" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Buscar" Style="{StaticResource BotonPrimario}"
                            Margin="10,0,0,0" Click="AlBuscar"/>
                    <StackPanel>
                        <TextBox x:Name="TxtBuscar" Height="42" FontSize="15" KeyDown="AlTeclaBuscar"
                                 ToolTip="Escaneá el código de barras o escribí el nombre"/>
                        <TextBlock Style="{StaticResource Subtitulo}" FontSize="11.5" Margin="2,5,0,0"
                                   Text="Escaneá o escribí y Enter.  Para varias unidades: 3*código o 3* y escaneá."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" x:Name="PanelResultados" Style="{StaticResource Tarjeta}"
                    Padding="0" Margin="0,0,0,12" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="14,7">
                        <TextBlock Style="{StaticResource Subtitulo}" FontSize="11.5"
                                   Text="↑ ↓ para elegir  ·  Enter agrega  ·  Esc vuelve al buscador"/>
                    </Border>
                    <DataGrid x:Name="GrillaResultados" MaxHeight="210" BorderThickness="0"
                              MouseDoubleClick="AlElegirResultado" KeyDown="AlTeclaResultados">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="150"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="110"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockFormateado}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{StaticResource Borde}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Quitar ítem"
                                    Style="{StaticResource BotonSecundario}" FontSize="12" Padding="12,6"
                                    Click="AlQuitarItem"/>
                            <TextBlock Text="Detalle de la venta" Style="{StaticResource TituloSeccion}"
                                       Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Atajos a la vista: es lo que hace que se dejen de usar los
                         botones. Si no están escritos, nadie los aprende. -->
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="16,9"
                            BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
                        <TextBlock Style="{StaticResource Subtitulo}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="F2 cantidad  ·  F3 cliente  ·  F4 medio de pago  ·  F5 paga con  ·  Supr quita el ítem  ·  F12 cobra  ·  Esc cancela"/>
                    </Border>

                    <DataGrid x:Name="GrillaCarrito" BorderThickness="0" IsReadOnly="False"
                              CellEditEnding="AlEditarCantidad" KeyDown="AlTeclaCarrito">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioConUnidad}"
                                                Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90"/>
                            <DataGridTextColumn Header="Desc." Binding="{Binding Descuento, StringFormat=C2}" Width="90"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}"
                                                Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Totales y cobro -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="BtnCobrar" Content="Cobrar   (F12)" Style="{StaticResource BotonExito}"
                            Height="52" FontSize="16" Click="AlCobrar"/>
                    <Button Content="Cancelar venta" Style="{StaticResource BotonSecundario}"
                            Height="38" Margin="0,8,0,0" Click="AlCancelar"/>
                </StackPanel>

                <StackPanel>
                    <!-- Confirmación de la última venta. Reemplaza al cartel modal:
                         el vuelto queda a la vista mientras el cajero cuenta la plata
                         y la venta siguiente puede empezar con un disparo del lector,
                         sin que nadie tenga que apretar Aceptar primero. -->
                    <Border x:Name="PanelVentaHecha" Background="#D1FAE5" CornerRadius="10"
                            BorderBrush="{StaticResource Exito}" BorderThickness="1.5"
                            Padding="14,12" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="LblVentaHecha" FontFamily="Segoe UI" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#065F46"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblTotalHecho" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                           Foreground="#065F46"/>
                            </DockPanel>

                            <Border x:Name="PanelVueltoHecho" Margin="0,9,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock Text="VUELTO" FontFamily="Segoe UI" FontSize="14"
                                               FontWeight="Bold" Foreground="#065F46"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblVueltoHecho" HorizontalAlignment="Right"
                                               FontFamily="Segoe UI" FontSize="34" FontWeight="Bold"
                                               Foreground="#065F46"/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Escaneá el primer producto de la venta siguiente, o apretá Enter."
                                       FontFamily="Segoe UI" FontSize="11" Foreground="#047857"
                                       TextWrapping="Wrap" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Cliente" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboCliente" DisplayMemberPath="NombreCompleto"
                              SelectedValuePath="ClienteId" Margin="0,0,0,14"/>

                    <Border Background="#F8FAFC" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Subtotal" Style="{StaticResource Subtitulo}"/>
                                <TextBlock x:Name="LblSubtotal" Text="$ 0,00" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextoPrimario}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Descuentos" Style="{StaticResource Subtitulo}"/>
                                <TextBlock x:Name="LblDescuentos" Text="$ 0,00" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Peligro}"/>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource Borde}" Margin="0,0,0,10"/>
                            <DockPanel>
                                <TextBlock Text="TOTAL" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextoPrimario}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblTotal" Text="$ 0,00" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource Primario}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- El descuento sobre el total es la vía más fácil de regalar
                         plata del negocio, así que va con el permiso más alto -->
                    <StackPanel x:Name="PanelDescuento">
                        <TextBlock Text="Descuento general" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtDescuentoGeneral" Text="0" TextChanged="AlCambiarDescuento"
                                 Margin="0,0,0,14"/>
                    </StackPanel>

                    <TextBlock Text="Medio de pago" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboMedioPago" DisplayMemberPath="NombreMedioPago"
                              SelectedValuePath="MedioPagoId" Margin="0,0,0,14"/>

                    <TextBlock Text="Paga con" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtPagaCon" FontSize="17" Height="44"
                             TextChanged="AlCambiarPago" KeyDown="AlTeclaPago"/>

                    <Border x:Name="PanelVuelto" Background="#D1FAE5" CornerRadius="8" Padding="12,9"
                            Margin="0,10,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock Text="Vuelto" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#065F46" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblVuelto" Text="$ 0,00" HorizontalAlignment="Right"
                                       FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="#065F46"/>
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="LblAviso" Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                               Foreground="{StaticResource Peligro}" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
