<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaCuentaCorriente"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Quién debe -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Actualizar" Margin="8,0,0,0"
                            Style="{StaticResource BotonSecundario}" FontSize="12" Padding="10,6"
                            Click="AlBuscar"/>
                    <CheckBox x:Name="ChkTodos" Content="Ver también los que están al día"
                              VerticalAlignment="Center" Click="AlBuscar"/>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource Fondo}" CornerRadius="10"
                        Padding="14" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock Text="TOTAL EN LA CALLE" FontFamily="Segoe UI" FontSize="12"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblTotalDeuda" Text="$ 0,00" HorizontalAlignment="Right"
                                   FontFamily="Segoe UI" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource Peligro}"/>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="GrillaSaldos" BorderThickness="0" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionChanged="AlSeleccionar">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                        <DataGridTextColumn Header="Debe" Binding="{Binding Saldo, StringFormat=C2}" Width="110"/>
                        <!-- Días desde el último movimiento: separa al que compra
                             todas las semanas del que quedó colgado. -->
                        <DataGridTextColumn Header="Días" Binding="{Binding DiasSinMovimiento}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Resumen de cuenta -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="LblCliente" Text="Elegí un cliente"
                               Style="{StaticResource TituloSeccion}"/>

                    <Border Background="{StaticResource Fondo}" CornerRadius="10" Padding="16"
                            Margin="0,0,0,14">
                        <DockPanel>
                            <TextBlock Text="SALDO" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblSaldo" Text="$ 0,00" HorizontalAlignment="Right"
                                       FontFamily="Segoe UI" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource Primario}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Cobrar -->
                <Border DockPanel.Dock="Bottom" x:Name="PanelCobro" Margin="0,14,0,0"
                        BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0" Padding="0,14,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="CUÁNTO PAGA" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="TxtPago" Text="0" FontSize="16" Height="42"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="CON QUÉ" Style="{StaticResource Etiqueta}"/>
                                <ComboBox x:Name="CboMedioPago" DisplayMemberPath="NombreMedioPago"
                                          SelectedValuePath="MedioPagoId" Height="42"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <Button x:Name="BtnPagar" Content="Registrar el pago" Height="42" MinWidth="170"
                                        Style="{StaticResource BotonExito}" Click="AlPagar"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel x:Name="PanelAjuste" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="Ajustar" Width="110" Margin="8,0,0,0"
                                    Style="{StaticResource BotonSecundario}" FontSize="12" Padding="10,6"
                                    Click="AlAjustar"/>
                            <TextBox DockPanel.Dock="Right" x:Name="TxtImporteAjuste" Width="110"
                                     Text="0" Margin="8,0,0,0"/>
                            <TextBox x:Name="TxtMotivoAjuste"
                                     ToolTip="Motivo del ajuste: por qué se mueve el saldo sin venta ni pago"/>
                        </DockPanel>
                        <TextBlock Text="El ajuste sirve para cargar una deuda vieja o perdonar un saldo. Positivo suma deuda, negativo la baja. Queda auditado."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,5,0,0"/>

                        <TextBlock x:Name="LblAviso" Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Peligro}" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="GrillaMovimientos" BorderThickness="0" AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yy HH:mm}" Width="110"/>
                        <DataGridTextColumn Header="Concepto" Binding="{Binding Detalle}" Width="*"/>
                        <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="*"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C2}" Width="110"/>
                        <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoAcumulado, StringFormat=C2}" Width="110"/>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tipo}" Value="PAGO">
                                    <Setter Property="Background" Value="#D1FAE5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tipo}" Value="ANULACION_VENTA">
                                    <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
