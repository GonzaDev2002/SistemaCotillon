<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaStock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Grid Margin="26,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,16,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{StaticResource Borde}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Desde" Style="{StaticResource Subtitulo}" VerticalAlignment="Center"/>
                        <DatePicker x:Name="FechaDesde" Width="130" Margin="8,0"/>
                        <TextBlock Text="Hasta" Style="{StaticResource Subtitulo}" VerticalAlignment="Center"/>
                        <DatePicker x:Name="FechaHasta" Width="130" Margin="8,0"/>
                        <Button Content="Buscar" Style="{StaticResource BotonPrimario}"
                                Margin="8,0,0,0" Click="AlBuscar"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="Grilla" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Width="130"
                                            Binding="{Binding FechaMovimiento, StringFormat=dd/MM/yyyy HH:mm}"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="140"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="70"/>
                        <DataGridTextColumn Header="Antes" Binding="{Binding StockAnterior}" Width="70"/>
                        <DataGridTextColumn Header="Después" Binding="{Binding StockNuevo}" Width="70"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="140"/>
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Observaciones}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
            <StackPanel>
                <TextBlock Text="Ajustar stock" Style="{StaticResource TituloSeccion}"/>
                <TextBlock Text="Todo ajuste queda registrado con su motivo y con el stock antes y después."
                           Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Text="PRODUCTO" Style="{StaticResource Etiqueta}"/>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotonSecundario}"
                            Padding="12,7" Margin="6,0,0,0" Click="AlBuscarProducto" ToolTip="Buscar producto">
                        <iconos:PackIconMaterial Kind="Magnify" Width="16" Height="16"/>
                    </Button>
                    <TextBox x:Name="TxtProducto" KeyDown="AlTeclaProducto"/>
                </DockPanel>

                <TextBlock x:Name="LblProducto" Style="{StaticResource Subtitulo}"
                           Foreground="{StaticResource Primario}" Margin="0,0,0,10"/>

                <TextBlock Text="TIPO" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="CboTipo" Margin="0,0,0,10">
                    <ComboBoxItem Content="AJUSTE" IsSelected="True"/>
                    <ComboBoxItem Content="MERMA"/>
                    <ComboBoxItem Content="DEVOLUCION"/>
                </ComboBox>

                <TextBlock Text="CANTIDAD (negativa para descontar)" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtCantidad" Text="0" Margin="0,0,0,10"/>

                <TextBlock Text="MOTIVO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtMotivo" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,14"/>

                <Button x:Name="BtnAjustar" Content="Registrar ajuste" Style="{StaticResource BotonPrimario}"
                        Click="AlAjustar" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
