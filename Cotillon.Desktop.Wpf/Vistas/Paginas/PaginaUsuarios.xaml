<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaUsuarios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Grid Margin="26,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="230"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Usuarios -->
            <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,14">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{StaticResource Borde}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" x:Name="ChkInactivos" Content="Ver inactivos"
                                      VerticalAlignment="Center" Click="AlRefrescar"/>
                            <TextBlock Text="Usuarios del sistema" Style="{StaticResource TituloSeccion}"
                                       Margin="0"/>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="Grilla" BorderThickness="0" SelectionChanged="AlSeleccionar">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="150"/>
                            <DataGridTextColumn Header="Nombre completo" Binding="{Binding NombreCompleto}" Width="*"/>
                            <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="110"/>
                            <DataGridTextColumn Header="Último acceso" Width="140"
                                                Binding="{Binding UltimoAcceso, StringFormat=dd/MM/yyyy HH:mm}"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Permisos del usuario elegido arriba -->
            <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{StaticResource Borde}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="34" Height="34" VerticalAlignment="Center"
                                  Margin="0,0,13,0">
                                <Border CornerRadius="10" Background="{StaticResource FichaAmbar}"
                                        Effect="{StaticResource SombraFicha}"/>
                                <Border CornerRadius="10" Background="{StaticResource BrilloFicha}"/>
                                <iconos:PackIconMaterial Kind="ShieldKeyOutline" Width="17" Height="17"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LblPermisos" Text="Permisos"
                                           Style="{StaticResource TituloSeccion}" Margin="0,0,0,1"/>
                                <TextBlock x:Name="LblAyudaPermisos" Style="{StaticResource Subtitulo}"
                                           TextWrapping="Wrap"
                                           Text="Elegí un usuario de la lista de arriba para ver y cambiar qué puede hacer en cada módulo."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="18,12" Background="#F8FAFC">
                        <DockPanel>
                            <Button x:Name="BtnGuardarPermisos" DockPanel.Dock="Right"
                                    Content="Guardar permisos" Style="{StaticResource BotonPrimario}"
                                    Click="AlGuardarPermisos" IsEnabled="False"/>
                            <Button x:Name="BtnPlantilla" DockPanel.Dock="Right"
                                    Content="Aplicar plantilla del rol" Style="{StaticResource BotonSecundario}"
                                    Margin="0,0,8,0" Click="AlAplicarPlantilla" IsEnabled="False"
                                    ToolTip="Vuelve a los permisos sugeridos para el rol del usuario"/>

                            <TextBlock Style="{StaticResource Subtitulo}" VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="Cada nivel incluye al anterior. Sin acceso = el módulo no aparece en el menú."/>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="GrillaPermisos" BorderThickness="0" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" IsEnabled="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Módulo" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6">
                                            <TextBlock Text="{Binding Modulo}" FontFamily="Segoe UI"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextoPrimario}"/>
                                            <TextBlock Text="{Binding Ayuda}" FontFamily="Segoe UI"
                                                       FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextoSecundario}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Puede" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="0,6"
                                                  ItemsSource="{Binding DataContext.Niveles,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Texto"
                                                  SelectedValuePath="Nivel"
                                                  SelectedValue="{Binding Nivel, Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Alta y edición -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="LblFormulario" Text="Nuevo usuario" Style="{StaticResource TituloSeccion}"/>

                    <TextBlock Text="NOMBRE DE USUARIO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtUsuario" Margin="0,0,0,10"/>

                    <TextBlock Text="NOMBRE COMPLETO" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtNombre" Margin="0,0,0,10"/>

                    <TextBlock Text="ROL" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboRol" Margin="0,0,0,4">
                        <ComboBoxItem Content="Cajero" IsSelected="True"/>
                        <ComboBoxItem Content="Supervisor"/>
                        <ComboBoxItem Content="Admin"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="El rol decide con qué permisos arranca. Después los ajustás abajo, uno por uno."/>

                    <TextBlock x:Name="LblPin" Text="PIN (mínimo 4 dígitos)" Style="{StaticResource Etiqueta}"/>
                    <PasswordBox x:Name="TxtPin" FontSize="14" Margin="0,0,0,10"/>

                    <CheckBox x:Name="ChkActivo" Content="Activo" IsChecked="True" Margin="0,0,0,14"/>

                    <Button x:Name="BtnGuardar" Content="Guardar" Style="{StaticResource BotonPrimario}"
                            Click="AlGuardar"/>
                    <Button Content="Nuevo (limpiar)" Style="{StaticResource BotonSecundario}"
                            Margin="0,8,0,0" Click="AlNuevo"/>
                    <Button x:Name="BtnResetPin" Content="Restablecer PIN"
                            Style="{StaticResource BotonSecundario}" Margin="0,8,0,0"
                            Click="AlResetearPin" IsEnabled="False"/>

                    <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Foreground="#92400E"
                                   Text="Los permisos ordenan el trabajo: cada uno ve lo suyo y no toca de más. No reemplazan el cuidado de las claves, porque quien tenga acceso a la PC del servidor puede llegar a los datos por fuera del programa."/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
