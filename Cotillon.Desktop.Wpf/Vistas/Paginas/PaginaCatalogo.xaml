<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaCatalogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="26,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Secciones -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <TextBlock Text="NOMBRE DE LA SECCIÓN" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtSeccion"/>
                    <CheckBox x:Name="ChkSeccionActiva" Content="Activa" IsChecked="True" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Agregar" Style="{StaticResource BotonPrimario}" Click="AlAgregarSeccion"/>
                        <Button Content="Actualizar" Style="{StaticResource BotonSecundario}"
                                Margin="8,0,0,0" Click="AlActualizarSeccion"/>
                        <Button Content="Limpiar" Style="{StaticResource BotonSecundario}"
                                Margin="8,0,0,0" Click="AlLimpiarSeccion"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Secciones" Style="{StaticResource TituloSeccion}"/>
                </StackPanel>

                <DataGrid x:Name="GrillaSecciones" SelectionChanged="AlSeleccionarSeccion">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sección" Binding="{Binding NombreSeccion}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activo}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Categorías -->
        <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="8,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <TextBlock Text="NOMBRE DE LA CATEGORÍA" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtCategoria"/>
                    <CheckBox x:Name="ChkCategoriaActiva" Content="Activa" IsChecked="True" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Agregar" Style="{StaticResource BotonPrimario}" Click="AlAgregarCategoria"/>
                        <Button Content="Actualizar" Style="{StaticResource BotonSecundario}"
                                Margin="8,0,0,0" Click="AlActualizarCategoria"/>
                        <Button Content="Limpiar" Style="{StaticResource BotonSecundario}"
                                Margin="8,0,0,0" Click="AlLimpiarCategoria"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="LblCategorias" Text="Categorías" Style="{StaticResource TituloSeccion}"/>
                </StackPanel>

                <DataGrid x:Name="GrillaCategorias" SelectionChanged="AlSeleccionarCategoria">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activo}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
