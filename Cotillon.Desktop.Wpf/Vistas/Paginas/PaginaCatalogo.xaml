<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaCatalogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cómo está pensada la organización, para que no haya que adivinarlo -->
        <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="18,14" Margin="0,0,0,14">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="34" Height="34" VerticalAlignment="Center"
                      Margin="0,0,13,0">
                    <Border CornerRadius="10" Background="{StaticResource FichaCeleste}"
                            Effect="{StaticResource SombraFicha}"/>
                    <Border CornerRadius="10" Background="{StaticResource BrilloFicha}"/>
                    <iconos:PackIconMaterial Kind="FileTree" Width="17" Height="17" Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sección › Categoría › Producto" FontFamily="Segoe UI" FontSize="13.5"
                               FontWeight="SemiBold" Foreground="{StaticResource TextoPrimario}"/>
                    <TextBlock Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                               Text="Dos niveles: la sección es el rubro grande (Globos, Piñatas, Cumpleaños) y la categoría el tipo dentro de ese rubro (Látex, Metalizados, Números). Todo producto va en una categoría, y por eso los reportes salen agrupados solos. Si una sección o categoría deja de usarse, desactivala: así no se ofrece al cargar productos nuevos pero el historial de ventas sigue mostrando su nombre."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Secciones -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Secciones" Style="{StaticResource TituloSeccion}" Margin="0,0,0,2"/>
                        <TextBlock Text="Elegí una para ver y editar sus categorías."
                                   Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <TextBlock Text="NOMBRE DE LA SECCIÓN" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtSeccion" KeyDown="AlTeclaSeccion"/>
                        <CheckBox x:Name="ChkSeccionActiva" Content="Se ofrece al cargar productos"
                                  IsChecked="True" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Agregar" Style="{StaticResource BotonPrimario}"
                                    Click="AlAgregarSeccion"/>
                            <Button x:Name="BtnActualizarSeccion" Content="Guardar cambios"
                                    Style="{StaticResource BotonSecundario}" Margin="8,0,0,0"
                                    Click="AlActualizarSeccion" IsEnabled="False"/>
                            <Button x:Name="BtnBorrarSeccion" Style="{StaticResource BotonPeligro}"
                                    Margin="8,0,0,0" Padding="11,7" Click="AlBorrarSeccion"
                                    IsEnabled="False" ToolTip="Borrar (sólo si está vacía)">
                                <iconos:PackIconMaterial Kind="TrashCanOutline" Width="14" Height="14"/>
                            </Button>
                            <Button Content="Limpiar" Style="{StaticResource BotonSecundario}"
                                    Margin="8,0,0,0" Click="AlLimpiarSeccion"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="GrillaSecciones" SelectionChanged="AlSeleccionarSeccion">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sección" Binding="{Binding NombreSeccion}" Width="*"/>
                            <DataGridTextColumn Header="Categorías" Width="90"
                                                Binding="{Binding CantidadCategorias}"/>
                            <DataGridTextColumn Header="Productos" Width="90"
                                                Binding="{Binding CantidadProductos}"/>
                            <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activo}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Categorías -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="8,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="LblCategorias" Text="Categorías"
                                   Style="{StaticResource TituloSeccion}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="LblAyudaCategorias" Style="{StaticResource Subtitulo}"
                                   Margin="0,0,0,10" Text="Elegí primero una sección de la izquierda."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <TextBlock Text="NOMBRE DE LA CATEGORÍA" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtCategoria" KeyDown="AlTeclaCategoria"/>

                        <!-- Cambiar la sección acá mueve la categoría con todos sus productos -->
                        <TextBlock Text="PERTENECE A LA SECCIÓN" Style="{StaticResource Etiqueta}"
                                   Margin="0,10,0,4"/>
                        <ComboBox x:Name="CboSeccionCategoria" DisplayMemberPath="NombreSeccion"
                                  SelectedValuePath="SeccionId"
                                  ToolTip="Cambiala para mover la categoría, con sus productos, a otra sección"/>

                        <CheckBox x:Name="ChkCategoriaActiva" Content="Se ofrece al cargar productos"
                                  IsChecked="True" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Agregar" Style="{StaticResource BotonPrimario}"
                                    Click="AlAgregarCategoria"/>
                            <Button x:Name="BtnActualizarCategoria" Content="Guardar cambios"
                                    Style="{StaticResource BotonSecundario}" Margin="8,0,0,0"
                                    Click="AlActualizarCategoria" IsEnabled="False"/>
                            <Button x:Name="BtnBorrarCategoria" Style="{StaticResource BotonPeligro}"
                                    Margin="8,0,0,0" Padding="11,7" Click="AlBorrarCategoria"
                                    IsEnabled="False" ToolTip="Borrar (sólo si no tiene productos)">
                                <iconos:PackIconMaterial Kind="TrashCanOutline" Width="14" Height="14"/>
                            </Button>
                            <Button Content="Limpiar" Style="{StaticResource BotonSecundario}"
                                    Margin="8,0,0,0" Click="AlLimpiarCategoria"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="GrillaCategorias" SelectionChanged="AlSeleccionarCategoria">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="*"/>
                            <DataGridTextColumn Header="Productos" Width="90"
                                                Binding="{Binding CantidadProductos}"/>
                            <DataGridCheckBoxColumn Header="Activa" Binding="{Binding Activo}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
