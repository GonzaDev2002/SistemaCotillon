<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaCaja"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Grid Margin="26,22">
        <!-- Caja cerrada -->
        <Border x:Name="PanelCerrada" Style="{StaticResource Tarjeta}" Padding="40"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
            <StackPanel>
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <Border CornerRadius="19" Background="{StaticResource FichaAmbar}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                              Opacity="0.35" Color="#78350F"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="19" Background="{StaticResource BrilloFicha}"/>
                    <iconos:PackIconMaterial Kind="LockOutline" Width="32" Height="32" Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="La caja está cerrada" Style="{StaticResource Titulo}" FontSize="20"
                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Abrí la caja para poder registrar ventas" Style="{StaticResource Subtitulo}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="MONTO INICIAL EN EFECTIVO" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtMontoInicial" Text="0" FontSize="20" Height="48"/>

                <TextBlock Text="OBSERVACIONES" Style="{StaticResource Etiqueta}" Margin="0,14,0,4"/>
                <TextBox x:Name="TxtObsApertura" Height="38"/>

                <Button x:Name="BtnAbrirCaja" Content="Abrir caja" Style="{StaticResource BotonExito}"
                        Height="46" FontSize="15" Margin="0,20,0,0" Click="AlAbrirCaja"/>
            </StackPanel>
        </Border>

        <!-- Caja abierta -->
        <Grid x:Name="PanelAbierta" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Movimientos -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,16,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{StaticResource Borde}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BotonSecundario}"
                                    Padding="12,7" Click="AlRefrescar" ToolTip="Actualizar">
                                <iconos:PackIconMaterial Kind="Refresh" Width="16" Height="16"/>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="Movimientos de la caja" Style="{StaticResource TituloSeccion}"
                                           Margin="0"/>
                                <TextBlock x:Name="LblApertura" Style="{StaticResource Subtitulo}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="GrillaMovimientos" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hora" Width="80"
                                                Binding="{Binding FechaMovimiento, StringFormat=HH:mm}"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="140"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="150"/>
                            <DataGridTextColumn Header="Importe" Width="120"
                                                Binding="{Binding Importe, StringFormat=C2}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Arqueo -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Arqueo" Style="{StaticResource TituloSeccion}"/>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Monto inicial" Style="{StaticResource Subtitulo}"/>
                                <TextBlock x:Name="LblMontoInicial" Text="$ 0,00" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="13.5"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Ventas" Style="{StaticResource Subtitulo}"/>
                                <TextBlock x:Name="LblTotalVentas" Text="$ 0,00" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="13.5"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Ingresos" Style="{StaticResource Subtitulo}"/>
                                <TextBlock x:Name="LblIngresos" Text="$ 0,00" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="13.5" Foreground="{StaticResource Exito}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Egresos" Style="{StaticResource Subtitulo}"/>
                                <TextBlock x:Name="LblEgresos" Text="$ 0,00" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="13.5" Foreground="{StaticResource Peligro}"/>
                            </DockPanel>

                            <Border Height="1" Background="{StaticResource Borde}" Margin="0,0,0,10"/>

                            <DockPanel>
                                <TextBlock Text="EFECTIVO ESPERADO" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="Bold" Foreground="{StaticResource TextoSecundario}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblEfectivoEsperado" Text="$ 0,00" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource Primario}"/>
                            </DockPanel>

                            <TextBlock Text="Por medio de pago" Style="{StaticResource Etiqueta}" Margin="0,14,0,4"/>
                            <ItemsControl x:Name="ListaMedios">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="{Binding MedioPago}" Style="{StaticResource Subtitulo}"/>
                                            <TextBlock Text="{Binding Total, StringFormat=C2}"
                                                       HorizontalAlignment="Right" FontFamily="Segoe UI" FontSize="13"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PanelMovimientoManual" Style="{StaticResource Tarjeta}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Ingreso / Egreso manual" Style="{StaticResource TituloSeccion}"/>

                            <TextBlock Text="TIPO" Style="{StaticResource Etiqueta}"/>
                            <ComboBox x:Name="CboTipoMovimiento" Margin="0,0,0,10">
                                <ComboBoxItem Content="INGRESO" IsSelected="True"/>
                                <ComboBoxItem Content="EGRESO"/>
                                <ComboBoxItem Content="RETIRO"/>
                            </ComboBox>

                            <TextBlock Text="IMPORTE" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtImporteMovimiento" Margin="0,0,0,10"/>

                            <TextBlock Text="MOTIVO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtMotivoMovimiento" Margin="0,0,0,12"/>

                            <Button Content="Registrar movimiento" Style="{StaticResource BotonSecundario}"
                                    Click="AlRegistrarMovimiento"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PanelCierre" Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <TextBlock Text="Cierre de caja" Style="{StaticResource TituloSeccion}"/>

                            <TextBlock Text="EFECTIVO CONTADO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtMontoContado" FontSize="18" Height="44"
                                     TextChanged="AlCambiarContado"/>

                            <Border x:Name="PanelDiferencia" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                                    Background="#F1F5F9" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock Text="Diferencia" FontFamily="Segoe UI" FontSize="12.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblDiferencia" Text="$ 0,00" HorizontalAlignment="Right"
                                               FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="OBSERVACIONES" Style="{StaticResource Etiqueta}" Margin="0,12,0,4"/>
                            <TextBox x:Name="TxtObsCierre" Height="36"/>

                            <Button x:Name="BtnCerrarCaja" Content="Cerrar caja" Style="{StaticResource BotonPeligro}"
                                    Height="44" Margin="0,14,0,0" Click="AlCerrarCaja"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
