<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaConfiguracion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Datos del negocio" Style="{StaticResource TituloSeccion}"/>
                    <TextBlock Text="Se usan en el encabezado del sistema y en los reportes."
                               Style="{StaticResource Subtitulo}" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="NOMBRE DEL NEGOCIO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtNombre"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                            <TextBlock Text="CUIT" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtCuit"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="DIRECCIÓN" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtDireccion"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                            <TextBlock Text="TELÉFONO" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtTelefono"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                            <TextBlock Text="TEXTO AL PIE DEL TICKET" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtPieTicket"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Preferencias de venta" Style="{StaticResource TituloSeccion}"/>
                    <CheckBox x:Name="ChkVentaSinStock" Content="Permitir vender productos sin stock disponible"/>
                    <TextBlock Text="Si está activo, el sistema deja vender aunque el stock llegue a cero. El stock puede quedar en negativo."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="26,4,0,0"/>

                    <TextBlock Text="RESPALDOS" Style="{StaticResource Etiqueta}" Margin="0,16,0,0"/>

                    <Border x:Name="PanelAvisoRespaldo" Background="#FEE2E2" CornerRadius="10"
                            Padding="14,11" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="LblAvisoRespaldo" FontFamily="Segoe UI" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#991B1B" TextWrapping="Wrap"/>
                    </Border>

                    <CheckBox x:Name="ChkRespaldoActivo" Content="Respaldar automáticamente"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="CADA CUÁNTOS DÍAS" Style="{StaticResource Etiqueta}"/>
                            <ComboBox x:Name="CboRespaldoDias" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="1" Content="Todos los días" IsSelected="True"/>
                                <ComboBoxItem Tag="2" Content="Cada 2 días"/>
                                <ComboBoxItem Tag="3" Content="Cada 3 días"/>
                                <ComboBoxItem Tag="7" Content="Una vez por semana"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="COPIAS QUE SE GUARDAN" Style="{StaticResource Etiqueta}"/>
                            <ComboBox x:Name="CboRespaldoCopias" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="7" Content="Las últimas 7"/>
                                <ComboBoxItem Tag="30" Content="Las últimas 30" IsSelected="True"/>
                                <ComboBoxItem Tag="90" Content="Las últimas 90"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="CARPETA QUE SE SUBE A LA NUBE" Style="{StaticResource Etiqueta}"
                               Margin="0,10,0,0"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Elegir" Width="80" Margin="6,0,0,0"
                                Style="{StaticResource BotonSecundario}" FontSize="12" Padding="8,6"
                                Click="AlElegirCarpetaNube"/>
                        <TextBox x:Name="TxtCarpetaNube"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Apuntá a tu carpeta de OneDrive, Drive o Dropbox y el respaldo se sube solo. Se copia un archivo ya terminado, no la base en uso: la base dentro de una carpeta sincronizada es la forma más común de corromperla. Vacío: la copia queda sólo en esta PC."/>

                    <Button x:Name="BtnRespaldarAhora" Content="Respaldar ahora"
                            Style="{StaticResource BotonSecundario}" Margin="0,10,0,0"
                            Click="AlRespaldarAhora"/>
                    <TextBlock x:Name="LblRespaldos" Style="{StaticResource Subtitulo}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <CheckBox x:Name="ChkArqueoCiego" Margin="0,14,0,0"
                              Content="Arqueo ciego: el que cuenta la caja no ve cuánto tendría que haber"/>
                    <TextBlock Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="26,4,0,0"
                               Text="Es el único control de caja que realmente funciona. Si el cajero ve el esperado antes de contar, un faltante se tapa escribiendo ese número en vez de lo que hay en el cajón, y la diferencia que queda registrada es siempre cero. Vos lo seguís viendo."/>

                    <TextBlock Text="TICKET" Style="{StaticResource Etiqueta}" Margin="0,16,0,0"/>
                    <ComboBox x:Name="CboAnchoTicket" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="32" Content="Impresora térmica de 58 mm"/>
                        <ComboBoxItem Tag="42" Content="Impresora térmica de 80 mm"/>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="La térmica se instala en Windows como cualquier impresora: no hace falta nada más. En una impresora común de hoja, el ticket sale como una tira angosta arriba a la izquierda."/>

                    <CheckBox x:Name="ChkTicketAutomatico" Margin="0,10,0,0"
                              Content="Imprimir el ticket al cobrar, sin preguntar"/>
                    <TextBlock Text="Si está apagado, el ticket se saca cuando el cliente lo pide, desde Historial de ventas."
                               Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="26,4,0,0"/>

                    <TextBlock Text="ETIQUETAS DE LA BALANZA" Style="{StaticResource Etiqueta}" Margin="0,16,0,0"/>
                    <TextBox x:Name="TxtMascaraBalanza"/>
                    <TextBlock Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,4,0,0">
                        Sólo si la balanza imprime etiquetas con código de barras. Al escanearlas, el peso
                        entra solo y no hay que tipearlo. Se describe el formato con una máscara: cada
                        dígito fijo es el prefijo de la balanza, C es el código del artículo, P el peso en
                        gramos, I el importe en centavos, y D el dígito verificador.
                        Lo más habitual es 20CCCCCPPPPPD. Vacío = apagado.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Conexión de esta terminal" Style="{StaticResource TituloSeccion}"/>
                    <TextBlock Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="En el equipo servidor dejá la dirección en localhost y marcá la casilla. En las demás terminales, poné la IP del servidor y desmarcala."/>

                    <TextBlock Text="DIRECCIÓN DEL SERVIDOR" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtUrlApi" Margin="0,0,0,10"/>

                    <CheckBox x:Name="ChkEsServidor" Content="Esta computadora es el servidor"/>

                    <TextBlock x:Name="LblReinicio" Style="{StaticResource Subtitulo}"
                               Foreground="{StaticResource Advertencia}" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="Collapsed"
                               Text="Los cambios de conexión se aplican al reiniciar el programa."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Base de datos" Style="{StaticResource TituloSeccion}"/>
                    <TextBlock x:Name="LblEstadoBase" Style="{StaticResource Subtitulo}" TextWrapping="Wrap"/>
                    <Button Content="Verificar conexión" Style="{StaticResource BotonSecundario}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="AlVerificar"/>
                </StackPanel>
            </Border>

            <Button x:Name="BtnGuardar" Content="Guardar configuración" Style="{StaticResource BotonPrimario}"
                    HorizontalAlignment="Left" Padding="24,12" Click="AlGuardar"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
