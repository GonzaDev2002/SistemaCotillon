<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaInicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22">
        <StackPanel>
            <!-- Aviso de respaldo. Va arriba de todo y en rojo porque es lo único
                 de esta pantalla que, si se ignora, puede costar el negocio
                 entero. Aparece sólo cuando hay algo que hacer. -->
            <Border x:Name="PanelRespaldo" Background="#FEE2E2" CornerRadius="12" Padding="16,13"
                    BorderBrush="{StaticResource Peligro}" BorderThickness="1.5"
                    Margin="0,0,0,18" Visibility="Collapsed">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="34" Height="34" VerticalAlignment="Center"
                          Margin="0,0,13,0">
                        <Border CornerRadius="10" Background="{StaticResource Peligro}"
                                Effect="{StaticResource SombraFicha}"/>
                        <iconos:PackIconMaterial Kind="DatabaseAlertOutline" Width="18" Height="18"
                                                 Foreground="White" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Grid>
                    <Button DockPanel.Dock="Right" x:Name="BtnRespaldar" Content="Respaldar ahora"
                            Style="{StaticResource BotonPeligro}" VerticalAlignment="Center"
                            Margin="13,0,0,0" Click="AlRespaldar"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LblRespaldo" FontFamily="Segoe UI" FontSize="14"
                                   FontWeight="Bold" Foreground="#991B1B" TextWrapping="Wrap"/>
                        <TextBlock Text="Si se rompe el disco de esta computadora, se pierde lo que no esté respaldado."
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#B91C1C"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- KPIs -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,8,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="44" Height="44" VerticalAlignment="Top">
                            <Border CornerRadius="13" Background="{StaticResource FichaIndigo}"
                                    Effect="{StaticResource SombraFicha}"/>
                            <Border CornerRadius="13" Background="{StaticResource BrilloFicha}"/>
                            <iconos:PackIconMaterial Kind="PackageVariantClosed" Width="22" Height="22"
                                                     Foreground="White" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="TOTAL PRODUCTOS" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="LblTotal" Text="-" FontFamily="Segoe UI" FontSize="30"
                                       FontWeight="Bold" Foreground="{StaticResource Primario}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tarjeta}" Margin="8,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="44" Height="44" VerticalAlignment="Top">
                            <Border CornerRadius="13" Background="{StaticResource FichaVerde}"
                                    Effect="{StaticResource SombraFicha}"/>
                            <Border CornerRadius="13" Background="{StaticResource BrilloFicha}"/>
                            <iconos:PackIconMaterial Kind="CheckDecagram" Width="22" Height="22"
                                                     Foreground="White" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="ACTIVOS" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="LblActivos" Text="-" FontFamily="Segoe UI" FontSize="30"
                                       FontWeight="Bold" Foreground="{StaticResource Exito}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tarjeta}" Margin="8,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="44" Height="44" VerticalAlignment="Top">
                            <Border CornerRadius="13" Background="{StaticResource FichaVioleta}"
                                    Effect="{StaticResource SombraFicha}"/>
                            <Border CornerRadius="13" Background="{StaticResource BrilloFicha}"/>
                            <iconos:PackIconMaterial Kind="ArchiveOutline" Width="22" Height="22"
                                                     Foreground="White" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="INACTIVOS" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="LblInactivos" Text="-" FontFamily="Segoe UI" FontSize="30"
                                       FontWeight="Bold" Foreground="{StaticResource TextoSecundario}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tarjeta}" Margin="8,0,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="44" Height="44" VerticalAlignment="Top">
                            <Border CornerRadius="13" Background="{StaticResource FichaAmbar}"
                                    Effect="{StaticResource SombraFicha}"/>
                            <Border CornerRadius="13" Background="{StaticResource BrilloFicha}"/>
                            <iconos:PackIconMaterial Kind="AlertDecagram" Width="22" Height="22"
                                                     Foreground="White" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="BAJO STOCK" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="LblBajoStock" Text="-" FontFamily="Segoe UI" FontSize="30"
                                       FontWeight="Bold" Foreground="{StaticResource Advertencia}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Accesos rápidos -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Accesos rápidos" Style="{StaticResource TituloSeccion}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BotonPrimario}" Padding="20,12" Click="AlIrAVentas">
                            <StackPanel Orientation="Horizontal">
                                <iconos:PackIconMaterial Kind="CartVariant" Width="17" Height="17"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Nueva venta" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BotonSecundario}" Padding="20,12" Margin="10,0,0,0"
                                Click="AlIrACaja">
                            <StackPanel Orientation="Horizontal">
                                <iconos:PackIconMaterial Kind="CashRegister" Width="17" Height="17"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Ir a caja" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BotonSecundario}" Padding="20,12" Margin="10,0,0,0"
                                Click="AlActualizar">
                            <StackPanel Orientation="Horizontal">
                                <iconos:PackIconMaterial Kind="Refresh" Width="17" Height="17"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Productos con bajo stock" Style="{StaticResource TituloSeccion}"/>
                        <DataGrid x:Name="GrillaBajoStock" Height="290">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="130"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
                                <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Últimos productos cargados" Style="{StaticResource TituloSeccion}"/>
                        <DataGrid x:Name="GrillaUltimos" Height="290">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="110"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
