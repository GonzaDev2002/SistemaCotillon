<UserControl x:Class="Cotillon.Desktop.Wpf.Vistas.Paginas.PaginaEncargues"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>

        <!-- Agenda: lo que hay que tener listo, ordenado por fecha de entrega -->
        <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Actualizar" Margin="8,0,0,0"
                            Style="{StaticResource BotonSecundario}" Click="AlBuscar"/>
                    <CheckBox DockPanel.Dock="Right" x:Name="ChkCerrados" Content="Ver entregados y cancelados"
                              VerticalAlignment="Center" Margin="12,0,0,0" Click="AlBuscar"/>
                    <ComboBox x:Name="CboPlazo" Width="190" SelectedValuePath="Tag"
                              HorizontalAlignment="Left" SelectionChanged="AlCambiarPlazo">
                        <ComboBoxItem Tag="7" Content="Para esta semana" IsSelected="True"/>
                        <ComboBoxItem Tag="30" Content="Para este mes"/>
                        <ComboBoxItem Tag="0" Content="Todos"/>
                    </ComboBox>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom" x:Name="LblResumen" Style="{StaticResource Subtitulo}"
                           Margin="0,10,0,0"/>

                <DataGrid x:Name="Grilla" BorderThickness="0" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionChanged="AlSeleccionar">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Entrega" Binding="{Binding FechaEntrega, StringFormat=dd/MM}" Width="70"/>
                        <DataGridTextColumn Header="Para" Binding="{Binding NombreContacto}" Width="*"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="100"/>
                        <DataGridTextColumn Header="Seña" Binding="{Binding Sena, StringFormat=C2}" Width="100"/>
                        <DataGridTextColumn Header="Falta" Binding="{Binding Saldo, StringFormat=C2}" Width="100"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <!-- Lo que se pasó de fecha y sigue sin entregar -->
                                <DataTrigger Binding="{Binding Atrasado}" Value="True">
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Estado}" Value="ENTREGADO">
                                    <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Estado}" Value="CANCELADO">
                                    <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="LblFormulario" Text="Nuevo encargue"
                               Style="{StaticResource TituloSeccion}"/>

                    <!-- Detalle del encargue elegido -->
                    <Border x:Name="PanelDetalle" Background="{StaticResource Fondo}" CornerRadius="10"
                            Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="LblDetalle" FontFamily="Segoe UI" FontSize="13"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <DataGrid x:Name="GrillaDetalle" MaxHeight="150" BorderThickness="0"
                                      Background="Transparent" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" IsReadOnly="True" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                                    <DataGridTextColumn Header="Cant." Binding="{Binding CantidadFormateada}" Width="Auto"/>
                                    <DataGridTextColumn Header="Importe" Binding="{Binding Subtotal, StringFormat=C2}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="LblSaldo" FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource Primario}" Margin="0,10,0,0"/>

                            <StackPanel x:Name="PanelEntrega" Margin="0,12,0,0">
                                <TextBlock Text="COBRAR AL ENTREGAR CON" Style="{StaticResource Etiqueta}"/>
                                <ComboBox x:Name="CboMedioEntrega" DisplayMemberPath="NombreMedioPago"
                                          SelectedValuePath="MedioPagoId" Margin="0,0,0,8"/>
                                <Button x:Name="BtnEntregar" Content="Entregar y cobrar el saldo"
                                        Style="{StaticResource BotonExito}" Click="AlEntregar"/>
                                <Button x:Name="BtnCancelarEncargue" Content="Cancelar el encargue"
                                        Style="{StaticResource BotonPeligro}" Margin="0,8,0,0"
                                        Click="AlCancelarEncargue"/>
                            </StackPanel>

                            <Button Content="Nuevo encargue" Style="{StaticResource BotonSecundario}"
                                    Margin="0,8,0,0" Click="AlNuevo"/>
                        </StackPanel>
                    </Border>

                    <!-- Alta -->
                    <StackPanel x:Name="PanelAlta">
                        <TextBlock Text="A NOMBRE DE" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtContacto" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="TELÉFONO" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="TxtTelefono"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="FECHA DE ENTREGA" Style="{StaticResource Etiqueta}"/>
                                <DatePicker x:Name="FechaEntrega"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="CLIENTE (opcional)" Style="{StaticResource Etiqueta}"/>
                        <ComboBox x:Name="CboCliente" DisplayMemberPath="NombreCompleto"
                                  SelectedValuePath="ClienteId" Margin="0,0,0,10"
                                  SelectionChanged="AlElegirCliente"/>

                        <TextBlock Text="QUÉ LLEVA" Style="{StaticResource Etiqueta}"/>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Agregar" Width="80" Margin="6,0,0,0"
                                    Style="{StaticResource BotonSecundario}" FontSize="12" Padding="8,6"
                                    Click="AlAgregarLinea"/>
                            <TextBox x:Name="TxtProducto" KeyDown="AlTeclaProducto"
                                     ToolTip="Escaneá el producto, o escribí «60*bolsita»"/>
                        </DockPanel>

                        <DataGrid x:Name="GrillaLineas" MaxHeight="170" BorderThickness="0"
                                  AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                                <DataGridTextColumn Header="Cant." Binding="{Binding CantidadFormateada}" Width="Auto"/>
                                <DataGridTextColumn Header="Importe" Binding="{Binding Subtotal, StringFormat=C2}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Quitar el renglón elegido" Style="{StaticResource BotonSecundario}"
                                FontSize="12" Padding="8,6" Margin="0,6,0,10" Click="AlQuitarLinea"/>

                        <Border Background="{StaticResource Fondo}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="TOTAL" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblTotal" Text="$ 0,00" HorizontalAlignment="Right"
                                           FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource Primario}"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="SEÑA QUE DEJA AHORA" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtSena" Text="0" FontSize="16" Height="42" Margin="0,0,0,4"/>
                        <TextBlock Text="La seña entra a la caja hoy. Al entregar se cobra sólo lo que falta."
                                   Style="{StaticResource Subtitulo}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="OBSERVACIONES" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtObservaciones" Height="52" AcceptsReturn="True"
                                 TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Button x:Name="BtnGuardar" Content="Tomar el encargue"
                                Style="{StaticResource BotonPrimario}" Click="AlGuardar"/>
                    </StackPanel>

                    <TextBlock x:Name="LblAviso" Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                               Foreground="{StaticResource Peligro}" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
