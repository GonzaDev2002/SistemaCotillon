<Window x:Class="Cotillon.Desktop.Wpf.Vistas.VentanaCarga"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconos="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Cotillón" Height="240" Width="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource Lateral}" Padding="34">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="56" Height="56" HorizontalAlignment="Center">
                <Border CornerRadius="17" Background="{StaticResource FichaRosa}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                          Opacity="0.5" Color="#0B0930"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="17" Background="{StaticResource BrilloFicha}"/>
                <iconos:PackIconMaterial Kind="PartyPopper" Width="29" Height="29" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="Cotillón" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="Iniciando el sistema..." FontFamily="Segoe UI" FontSize="13"
                       Foreground="#C7D2FE" HorizontalAlignment="Center" Margin="0,6,0,16"/>
            <ProgressBar IsIndeterminate="True" Height="4" Width="240" Foreground="{StaticResource Acento}"
                         Background="#312E81" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>
