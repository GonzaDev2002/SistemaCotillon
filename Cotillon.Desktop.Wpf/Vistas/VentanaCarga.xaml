<Window x:Class="Cotillon.Desktop.Wpf.Vistas.VentanaCarga"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cotillón" Height="220" Width="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource Lateral}" Padding="34">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🎉" FontSize="42" HorizontalAlignment="Center"/>
            <TextBlock Text="Cotillón" FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="Iniciando el sistema..." FontFamily="Segoe UI" FontSize="13"
                       Foreground="#C7D2FE" HorizontalAlignment="Center" Margin="0,6,0,16"/>
            <ProgressBar IsIndeterminate="True" Height="4" Width="240" Foreground="{StaticResource Acento}"
                         Background="#312E81" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>
