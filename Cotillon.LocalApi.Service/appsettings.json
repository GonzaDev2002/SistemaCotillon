{
  // En qué direcciones escucha el servicio.
  //
  // 0.0.0.0 acepta conexiones de la red, que es lo que hace falta para que una
  // segunda terminal o la PC del administrador puedan entrar. Con "localhost"
  // sólo entra la aplicación que corre en la misma máquina.
  //
  // El servicio NO pide credenciales en cada llamada: el borde de seguridad es
  // la red. Está bien en la red del local, pero esto no se publica a internet
  // con un redireccionamiento de puertos — quien tenga la dirección leería y
  // escribiría todo el negocio. Para entrar de afuera va una VPN, que deja
  // pasar sólo a los equipos dados de alta.
  "Urls": "http://0.0.0.0:5189",
  "BaseDatos": {
    "Ruta": ""
  },
  "Logs": {
    "Ruta": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
